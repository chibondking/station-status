# Copy this to /opt/station-status/server/status.env and fill in real values.
# This file should NOT be committed to git (see .gitignore) and should be
# readable only by the service user: chmod 600 status.env

# Pick a real random secret, not this placeholder. e.g.: openssl rand -hex 32
STATUS_API_TOKEN=changeme

# Bind to localhost only -- nginx is what the internet actually talks to.
# Do not expose this port directly to the internet.
STATUS_HOST=127.0.0.1
STATUS_PORT=8000

# Seconds of silence before a station/radio is marked Offline. Should be a
# few multiples of the agent's report_interval_seconds (default 5s in
# config.example.json), so 15-20 is reasonable.
STATUS_OFFLINE_THRESHOLD=20
